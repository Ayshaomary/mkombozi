DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=mukombozi
DB_USER=mukombozi_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Set to "sqlite" to use a local file database instead of PostgreSQL
DB_ENGINE=postgres

# SonicPesa mobile money (from the API Settings page on sonicpesa.com).
# Leave empty to confirm subscription payments by hand in the Django admin.
SONICPESA_API_KEY=
SONICPESA_API_SECRET=

# ClickPesa BillPay control numbers (from the ClickPesa Dashboard > Settings > Developers).
# Leave empty to hide the "Control number" way to pay.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=
# Your M-Pesa merchant number from ClickPesa, shown to payers in the M-Pesa steps
CLICKPESA_MPESA_BUSINESS_NUMBER=

# Beem Africa SMS for password reset codes (from beem.africa > Profile > Authentication Information).
# Leave empty on your computer: the code is then printed in the backend terminal.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=INFO
